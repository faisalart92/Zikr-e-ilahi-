<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:padding="14dp" android:background="@drawable/prayer_widget_bg">
 <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:text="☪ Noor-e-Hidayat" android:textColor="#F0D28D" android:textSize="17sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_date" android:layout_below="@id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:textColor="#C8D8CC" android:textSize="12sp" android:layout_marginTop="4dp"/>
 <TextView android:id="@+id/widget_fajr" android:layout_below="@id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Fajr --:--" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="10dp"/>
 <TextView android:id="@+id/widget_dhuhr" android:layout_below="@id/widget_fajr" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Dhuhr --:--" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_asr" android:layout_below="@id/widget_dhuhr" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Asr --:--" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_maghrib" android:layout_below="@id/widget_asr" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Maghrib --:--" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_isha" android:layout_below="@id/widget_maghrib" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Isha --:--" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_location" android:layout_below="@id/widget_isha" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Prayer timings" android:textColor="#F0D28D" android:textSize="11sp" android:layout_marginTop="8dp"/>
 <TextView android:id="@+id/widget_hint" android:layout_below="@id/widget_location" android:layout_width="match_parent" android:layout_height="wrap_content"
 android:text="Tap to open" android:textColor="#C8D8CC" android:textSize="10sp" android:layout_marginTop="4dp"/>
</RelativeLayout>